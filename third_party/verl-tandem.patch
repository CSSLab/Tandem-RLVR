+        return node_cuda_visible_devices
+    owned = node_cuda_visible_devices.split(",")
+    extra = [g for g in all_gpus if g not in owned]
+    if not extra:
+        return node_cuda_visible_devices
+    logger.info("Tandem: widening server visible devices %s with spare GPUs %s", node_cuda_visible_devices, extra)
+    return ",".join(owned + extra)
