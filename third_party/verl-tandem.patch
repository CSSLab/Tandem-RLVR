+def _apply_tandem_senior_gate(config, response_mask, data, metrics):
+    tandem_gate = data.get("tandem_model_mask", None)
+    if tandem_gate is None:
+        return response_mask
+    if tandem_gate.is_nested:
+        tandem_gate = tandem_gate.to_padded_tensor(0)
+    gate = tandem_gate.to(device=response_mask.device).bool()
+    jr_tkn_weight = getattr(config, "tandem_jr_tkn_weight", 0.0)
+    if jr_tkn_weight > 0:
+        gated = response_mask.to(torch.float32) * (gate.to(torch.float32) + (~gate).to(torch.float32) * jr_tkn_weight)
+    else:
+        gated = response_mask & gate
+    denom = response_mask.sum().clamp(min=1).to(torch.float32)
+    senior_frac = ((response_mask & gate).sum().to(torch.float32) / denom).detach()
+    metrics["actor/tandem_senior_token_frac"] = Metric(value=senior_frac, aggregation=AggregationType.MEAN)
+    return gated
+
