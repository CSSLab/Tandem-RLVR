new file mode 100644
index 0000000..bd6edd4
--- /dev/null
+++ b/vllm/v1/worker/tandem.py
@@ -0,0 +1,239 @@
+
+import copy
+import time
+from contextlib import nullcontext
+from typing import Any, Optional
+
+import torch
+from torch import nn
+
+from vllm.model_executor.layers.attention import Attention
+from vllm.config import TandemConfig, VllmConfig, set_current_vllm_config
+from vllm.distributed.parallel_state import (
+    get_tensor_model_parallel_rank, get_tensor_model_parallel_world_size)
+from vllm.forward_context import set_forward_context
+from vllm.logger import init_logger
+from vllm.model_executor.model_loader import DefaultModelLoader
+from vllm.model_executor.model_loader.utils import initialize_model
+from vllm.utils.torch_utils import set_default_torch_dtype
+
+logger = init_logger(__name__)
+
+FROZEN_PREFIX = "tandem_frozen."
+
+
+def is_frozen_layer(layer_name: str) -> bool:
+    return layer_name.startswith(FROZEN_PREFIX)
+
+
+def _frozen_tp_context():
+    return nullcontext()
+
+
+class TandemModelManager:
+
+    def __init__(self, tandem_config: TandemConfig,
+                 primary_vllm_config: VllmConfig):
+        self.tandem_config = tandem_config
+        self.primary_vllm_config = primary_vllm_config
+        self.frozen_model: Optional[nn.Module] = None
+        self.frozen_device: Optional[torch.device] = None
+        self.frozen_kv_caches: list[torch.Tensor] = []
+        self.frozen_layer_names: list[str] = []
+
+    def _build_frozen_vllm_config(self) -> VllmConfig:
+        tc = self.tandem_config
+        primary = self.primary_vllm_config
+        saved_sfc = primary.compilation_config.static_forward_context
+        primary.compilation_config.static_forward_context = {}
+        try:
+            frozen_config = copy.deepcopy(primary)
+        finally:
+            primary.compilation_config.static_forward_context = saved_sfc
+        if tc.frozen_model != primary.model_config.model:
+            frozen_config.model_config.model = tc.frozen_model
+            if tc.frozen_model_revision:
+                frozen_config.model_config.revision = tc.frozen_model_revision
+            from vllm.transformers_utils.config import (get_config,
+                                                        get_hf_text_config)
+            frozen_hf_config = get_config(
+                tc.frozen_model,
+                trust_remote_code=frozen_config.model_config.trust_remote_code,
+                revision=tc.frozen_model_revision,
+            )
+            frozen_config.model_config.hf_config = frozen_hf_config
+            frozen_config.model_config.hf_text_config = get_hf_text_config(
+                frozen_hf_config)
+        if tc.frozen_quantization:
+            frozen_config.model_config.quantization = tc.frozen_quantization
+        if tc.frozen_max_model_len:
+            frozen_config.model_config.max_model_len = tc.frozen_max_model_len
+        frozen_config.load_config.load_format = "auto"
+        frozen_config.device_config.device = self.frozen_device
+        frozen_config.device_config.device_type = self.frozen_device.type
+        return frozen_config
+
+    def _resolve_frozen_device(self) -> torch.device:
+        tc = self.tandem_config
+        tp_rank = get_tensor_model_parallel_rank()
+        tp_size = get_tensor_model_parallel_world_size()
+        if tc.frozen_gpu_devices:
+            device_id = tc.frozen_gpu_devices[tp_rank]
+        else:
+            device_id = tp_rank + tp_size
+        return torch.device(f"cuda:{device_id}")
+
+    def load_frozen_model(self) -> None:
+        tc = self.tandem_config
+        if not tc.enabled:
+            return
+        self.frozen_device = self._resolve_frozen_device()
+        logger.info("Loading frozen tandem model %s on %s (TP rank %d)...",
+                    tc.frozen_model, self.frozen_device,
+                    get_tensor_model_parallel_rank())
+        frozen_vllm_config = self._build_frozen_vllm_config()
+        loader = DefaultModelLoader(frozen_vllm_config.load_config)
+        time_before = time.perf_counter()
+        with set_default_torch_dtype(frozen_vllm_config.model_config.dtype):
+            with torch.device(self.frozen_device):
+                with set_current_vllm_config(frozen_vllm_config):
+                    with _frozen_tp_context():
+                        self.frozen_model = initialize_model(
+                            vllm_config=frozen_vllm_config, prefix=FROZEN_PREFIX)
+            self.frozen_model.load_weights(
+                loader.get_all_weights(frozen_vllm_config.model_config,
+                                       self.frozen_model))
+        self.frozen_model.eval()
+        for param in self.frozen_model.parameters():
+            param.requires_grad_(False)
+        merged = self._merge_frozen_layers(frozen_vllm_config)
+        elapsed = time.perf_counter() - time_before
+        logger.info("Frozen tandem model loaded on %s in %.2fs (%d attn merged)",
+                    self.frozen_device, elapsed, merged)
+
+    def _merge_frozen_layers(self, frozen_vllm_config: VllmConfig) -> int:
+        frozen_sfc = frozen_vllm_config.compilation_config.static_forward_context
+        primary_sfc = \
+            self.primary_vllm_config.compilation_config.static_forward_context
+        count = 0
+        for name, layer in frozen_sfc.items():
+            if is_frozen_layer(name) and name not in primary_sfc:
+                primary_sfc[name] = layer
+                count += 1
+        return count
+
+    def initialize_frozen_kv_cache(self, primary_kv_cache_config: Any,
+                                   attn_backend: Any) -> None:
+        if self.frozen_model is None:
+            return
+        from vllm.v1.worker.utils import bind_kv_cache
+        sfc = self.primary_vllm_config.compilation_config.static_forward_context
+        frozen_layers = {
+            name: layer for name, layer in sfc.items()
+            if is_frozen_layer(name) and isinstance(layer, Attention)
+        }
+        if not frozen_layers:
+            logger.warning("No frozen attention layers in static_forward_context")
+            return
+        self.frozen_layer_names = list(frozen_layers.keys())
+        num_blocks = primary_kv_cache_config.num_blocks
+        block_size = self.primary_vllm_config.cache_config.block_size
+        kv_cache_dtype = self.primary_vllm_config.cache_config.cache_dtype
+        if kv_cache_dtype == "auto":
+            kv_cache_dtype = self.primary_vllm_config.model_config.dtype
+        frozen_kv_caches = self._alloc_frozen_caches(frozen_layers, attn_backend,
+                                                     num_blocks, block_size,
+                                                     kv_cache_dtype)
+        bind_kv_cache(frozen_kv_caches, sfc, self.frozen_kv_caches)
+        logger.info("Frozen tandem KV cache: %d layers, %d blocks on %s",
+                    len(frozen_kv_caches), num_blocks, self.frozen_device)
+
+    def _alloc_frozen_caches(self, frozen_layers, attn_backend, num_blocks,
+                             block_size, kv_cache_dtype) -> dict:
+        frozen_kv_caches: dict[str, torch.Tensor] = {}
+        shared: dict[str, str] = {}
+        for layer_name, attn_module in frozen_layers.items():
+            target = getattr(attn_module, "kv_sharing_target_layer_name", None)
+            if target is not None:
+                shared[layer_name] = target
+                continue
+            shape = attn_backend.get_kv_cache_shape(
+                num_blocks, block_size, attn_module.num_kv_heads,
+                attn_module.head_size)
+            frozen_kv_caches[layer_name] = torch.zeros(
+                shape, dtype=kv_cache_dtype, device=self.frozen_device)
+        for layer_name, target in shared.items():
+            if target in frozen_kv_caches:
+                frozen_kv_caches[layer_name] = frozen_kv_caches[target]
+        return frozen_kv_caches
+
+    def frozen_forward(self, input_ids: torch.Tensor, positions: torch.Tensor,
+                       attn_metadata: Any, num_scheduled_tokens: int,
+                       logits_indices: torch.Tensor,
+                       slot_mappings: Any) -> torch.Tensor:
+        with torch.cuda.device(self.frozen_device):
+            return self._frozen_forward_impl(input_ids, positions,
+                                             attn_metadata, num_scheduled_tokens,
+                                             logits_indices, slot_mappings)
+
+    def _frozen_forward_impl(self, input_ids: torch.Tensor,
+                             positions: torch.Tensor, attn_metadata: Any,
+                             num_scheduled_tokens: int,
+                             logits_indices: torch.Tensor,
+                             slot_mappings: Any) -> torch.Tensor:
+        frozen_input_ids = input_ids.to(self.frozen_device)
+        frozen_positions = positions.to(self.frozen_device)
+        frozen_logits_indices = logits_indices.to(self.frozen_device)
+        frozen_attn_metadata = self._adapt_attn_metadata(attn_metadata)
+        frozen_slot_mapping = self._adapt_slot_mapping(slot_mappings)
+        model = getattr(self.frozen_model, "language_model", self.frozen_model)
+        with _frozen_tp_context():
+            with set_forward_context(frozen_attn_metadata,
+                                     self.primary_vllm_config,
+                                     slot_mapping=frozen_slot_mapping):
+                hidden_states = model(
+                    input_ids=frozen_input_ids, positions=frozen_positions,
+                    intermediate_tensors=None, inputs_embeds=None)
+            hidden_states = hidden_states[:num_scheduled_tokens]
+            sample_hidden_states = hidden_states[frozen_logits_indices]
+            frozen_logits = model.compute_logits(sample_hidden_states)
+        return frozen_logits
+
+    def _bare_layer(self, frozen_name: str) -> str:
+        prefix = FROZEN_PREFIX + "."
+        return frozen_name[len(prefix):] if frozen_name.startswith(prefix) else frozen_name
+
+    def _adapt_attn_metadata(self, primary_metadata: Any) -> Any:
+        if isinstance(primary_metadata, dict):
+            adapted = {k: self._adapt_one(v) for k, v in primary_metadata.items()}
+            rep = next(iter(adapted.values()))
+            names = self.frozen_layer_names or [
+                FROZEN_PREFIX + "." + k for k in primary_metadata]
+            return {n: adapted.get(self._bare_layer(n), rep) for n in names}
+        return self._adapt_one(primary_metadata)
+
+    def _adapt_one(self, md: Any) -> Any:
+        adapted = copy.copy(md)
+        for name, val in list(vars(md).items()):
+            if isinstance(val, torch.Tensor):
+                setattr(adapted, name, val.to(self.frozen_device))
+        return adapted
+
+    def _adapt_slot_mapping(self, slot_mappings: Any) -> Any:
+        if not isinstance(slot_mappings, dict):
+            return slot_mappings
+        adapted = {k: v.to(self.frozen_device) for k, v in slot_mappings.items()}
+        rep = next(iter(adapted.values()))
+        names = self.frozen_layer_names or [
+            FROZEN_PREFIX + "." + k for k in slot_mappings]
+        return {n: adapted.get(self._bare_layer(n), rep) for n in names}
+
+    def get_frozen_model(self) -> nn.Module:
+        if self.frozen_model is None:
+            raise RuntimeError("Frozen model not loaded.")
+        return self.frozen_model
+
+    def get_frozen_device(self) -> torch.device:
+        if self.frozen_device is None:
+            raise RuntimeError("Frozen device not set.")
+        return self.frozen_device
