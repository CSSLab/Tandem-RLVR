+            req_ids = None
+        else:
+            out_tok = [self.requests[rid].output_token_ids for rid in req_ids]
+        sampler_output, mask, partner_logprob = self.tandem_sampler.forward(
+            logits, frozen_logits, sampling_metadata, force_primary=force_primary,
+            req_ids=req_ids, output_token_ids=out_tok)
+        self._tandem_frozen_logits = None
+        self._tandem_mask = mask
+        self._tandem_partner_logprob = partner_logprob
