+        self._tandem_frozen_logits = mgr.frozen_forward(
+            input_ids, positions, attn_metadata, num_scheduled_tokens,
+            logits_indices, slot_mappings)
+
+    def _maybe_tandem_sample(self, logits, sampling_metadata):
