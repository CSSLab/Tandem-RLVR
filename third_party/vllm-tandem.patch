+        mgr.initialize_frozen_kv_cache(kv_cache_config, attn_backend)
+
+    def _tandem_compute_frozen(self, input_ids, positions, attn_metadata,
+                               num_scheduled_tokens, logits_indices,
+                               slot_mappings) -> None:
+        mgr = getattr(self, "tandem_manager", None)
+        if mgr is None:
+            self._tandem_frozen_logits = None
