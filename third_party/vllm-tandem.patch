diff --git a/vllm/v1/sample/tandem_sampler.py b/vllm/v1/sample/tandem_sampler.py
new file mode 100644
index 0000000..121335a
--- /dev/null
+++ b/vllm/v1/sample/tandem_sampler.py
@@ -0,0 +1,183 @@
+
+import torch
+import torch.nn as nn
+
+from vllm.config import TandemConfig
+from vllm.logger import init_logger
+from vllm.v1.outputs import LogprobsTensors, SamplerOutput
+from vllm.v1.sample.metadata import SamplingMetadata
+from vllm.v1.sample.sampler import Sampler
+
+logger = init_logger(__name__)
+
+
+class TandemSampler(nn.Module):
+
+    def __init__(self, tandem_config: TandemConfig):
+        super().__init__()
+        self.strategy = tandem_config.selection_strategy
+        self.prob_primary = tandem_config.prob_primary
+        self.chunk_size = max(1, getattr(tandem_config, "chunk_size", 1))
+        self.max_gap_tokens = max(1, getattr(tandem_config, "max_gap_tokens", 32))
+        self.sampler = Sampler()
+        self._step = 0
+        self._word_state: dict = {}
+        self.boundary_token_ids: frozenset[int] = (
+            frozenset(tandem_config.boundary_token_ids)
+            if tandem_config.boundary_token_ids else frozenset())
+
+    def forward(self, primary_logits: torch.Tensor,
+                frozen_logits: torch.Tensor,
+                sampling_metadata: SamplingMetadata,
+                force_primary: torch.Tensor | None = None,
+                req_ids: list | None = None,
+                output_token_ids: list | None = None,
+                ) -> tuple[SamplerOutput, torch.Tensor, torch.Tensor]:
+        batch_size = primary_logits.shape[0]
+        frozen_logits = frozen_logits.to(primary_logits.device)
+        primary_output = self.sampler(primary_logits.clone(), sampling_metadata)
+        frozen_output = self.sampler(frozen_logits.clone(), sampling_metadata)
+        primary_tokens = primary_output.sampled_token_ids.squeeze(-1)
+        frozen_tokens = frozen_output.sampled_token_ids.squeeze(-1)
+        use_primary = self._select(batch_size, primary_logits.device,
+                                   sampling_metadata, req_ids,
+                                   output_token_ids)
+        if force_primary is not None:
+            use_primary = use_primary | force_primary.to(use_primary.device)
+        chosen_tokens = torch.where(use_primary, primary_tokens, frozen_tokens)
+        if self.strategy == "word" and req_ids is not None:
+            self._word_post_update(req_ids, chosen_tokens.tolist(),
+                                   use_primary.tolist(), sampling_metadata)
+        model_mask = use_primary.to(torch.int32)
+        frozen_logprobs = torch.log_softmax(frozen_logits, dim=-1)
+        partner_logprob = frozen_logprobs.gather(
+            1, chosen_tokens.unsqueeze(-1)).squeeze(-1)
+        logprobs_tensors = self._merge_logprobs(
+            primary_output.logprobs_tensors,
+            frozen_output.logprobs_tensors, use_primary)
+        self._step += 1
+        sampler_output = SamplerOutput(
+            sampled_token_ids=chosen_tokens.unsqueeze(-1),
+            logprobs_tensors=logprobs_tensors)
+        return sampler_output, model_mask, partner_logprob
+
+    def _merge_logprobs(self, primary_lp, frozen_lp, use_primary):
+        if primary_lp is None or frozen_lp is None:
+            return primary_lp
+        sel = use_primary.view(-1, 1)
+        return LogprobsTensors(
+            torch.where(sel, primary_lp.logprob_token_ids,
+                        frozen_lp.logprob_token_ids),
+            torch.where(sel, primary_lp.logprobs, frozen_lp.logprobs),
+            torch.where(use_primary, primary_lp.selected_token_ranks,
+                        frozen_lp.selected_token_ranks))
+
+    def _select(self, batch_size: int, device: torch.device,
+                sampling_metadata: SamplingMetadata,
+                req_ids: list | None = None,
+                output_token_ids: list | None = None) -> torch.Tensor:
+        if self.strategy == "bernoulli":
+            return torch.rand(batch_size, device=device) < self.prob_primary
+        elif self.strategy == "chunk":
+            return self._chunk_select(batch_size, device)
+        elif self.strategy == "alternating":
+            return torch.full((batch_size,), self._step % 2 == 0,
+                              dtype=torch.bool, device=device)
+        elif self.strategy == "sentence":
+            return self._sentence_select(batch_size, device, sampling_metadata,
+                                         output_token_ids)
+        elif self.strategy == "word":
+            return self._word_select(batch_size, device, sampling_metadata,
+                                     req_ids, output_token_ids)
+        raise ValueError(f"Unknown strategy: {self.strategy}")
+
+    def _rows(self, sampling_metadata, output_token_ids, batch_size):
+        rows = (output_token_ids if output_token_ids is not None
+                else sampling_metadata.output_token_ids)
+        if len(rows) != batch_size and not getattr(self, "_rows_warned", False):
+            self._rows_warned = True
+            logger.warning(
+                "TandemSampler: %d output-token rows for batch of %d; "
+                "missing rows default to the primary author",
+                len(rows), batch_size)
+        return rows
+
+    def _sentence_select(self, batch_size: int, device: torch.device,
+                         sampling_metadata: SamplingMetadata,
+                         output_token_ids: list | None = None) -> torch.Tensor:
+        use_primary = torch.ones(batch_size, dtype=torch.bool, device=device)
+        boundary_ids = self.boundary_token_ids
+        rows = self._rows(sampling_metadata, output_token_ids, batch_size)
+        for i, token_ids in enumerate(rows[:batch_size]):
+            n_boundaries = sum(1 for tid in token_ids if tid in boundary_ids)
+            use_primary[i] = (n_boundaries % 2 == 0)
+        return use_primary
+
+    def _word_select(self, batch_size: int, device: torch.device,
+                     sampling_metadata: SamplingMetadata,
+                     req_ids: list | None = None,
+                     output_token_ids: list | None = None) -> torch.Tensor:
+        use_primary = torch.ones(batch_size, dtype=torch.bool, device=device)
+        rows = self._rows(sampling_metadata, output_token_ids, batch_size)
+        for i in range(batch_size):
+            key = req_ids[i] if req_ids is not None else (
+                id(rows[i]) if i < len(rows) else i)
+            st = self._word_state.get(key)
+            if st is None:
+                prefix = rows[i] if i < len(rows) else []
+                st = self._word_replay(prefix, sampling_metadata, i)
+                self._word_state[key] = st
+            use_primary[i] = st[0]
+        if req_ids is not None:
+            live = set(req_ids)
+            self._word_state = {k: v for k, v in self._word_state.items()
+                                if k in live}
+        return use_primary
+
+    def _word_replay(self, prefix, sampling_metadata, i):
+        author = self._draw_active(sampling_metadata, i, self.prob_primary)
+        since = 0
+        for tid in prefix:
+            if tid < 0:
+                continue
+            since += 1
+            if tid in self.boundary_token_ids or since >= self.max_gap_tokens:
+                author = self._draw_active(sampling_metadata, i,
+                                           self.prob_primary)
+                since = 0
+        return [author, since]
+
+    def _word_post_update(self, req_ids, chosen_tokens, use_primary_rows,
+                          sampling_metadata):
+        for i, key in enumerate(req_ids):
+            st = self._word_state.get(key)
+            if st is None:
+                continue
+            tid = chosen_tokens[i]
+            if isinstance(tid, list):
+                tid = tid[0]
+            st[1] += 1
+            if tid in self.boundary_token_ids or st[1] >= self.max_gap_tokens:
+                st[0] = self._draw_active(sampling_metadata, i,
+                                          self.prob_primary)
+                st[1] = 0
+
+    def _draw_active(self, sampling_metadata: SamplingMetadata, i: int,
+                     p: float) -> bool:
+        gen = sampling_metadata.generators.get(i)
+        if gen is not None:
+            draw = torch.rand(1, generator=gen, device=gen.device).item()
+        else:
+            draw = float(torch.rand(1).item())
+        return draw < p
+
+    def _chunk_select(self, batch_size: int,
+                      device: torch.device) -> torch.Tensor:
+        pos = self._step % (2 * self.chunk_size)
+        is_primary = pos < self.chunk_size
+        return torch.full((batch_size,), is_primary, dtype=torch.bool,
+                          device=device)
+
+    def reset(self):
+        self._step = 0
+        self._word_state = {}
