# Site configuration. Every launcher in train/ sources train/env.sh as its first
# action, and so does eval/run_all.sh. Copy this file to train/env.sh, edit the
# values, and leave it uncommitted (train/.gitignore excludes it).
#
# This file is sourced, never executed: it only sets variables.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# bin/ of the conda environment built by env/install.sh. It is prepended to PATH
# rather than activated so the launchers work under a batch scheduler, where no
# interactive shell has run conda init.
TANDEM_ENV_BIN=${TANDEM_ENV_BIN:-$HOME/miniconda3/envs/tandem-rlvr/bin}
export PATH="$TANDEM_ENV_BIN:$PATH"

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
# One value for three roles: the senior's initialisation, the frozen junior in
# the tandem arm, and the reference policy in the KL-Reg ablation. A local
# directory works in place of the hub id.
export BASE_MODEL=${BASE_MODEL:-Qwen/Qwen3-4B-Instruct-2507}

# eval/run_all.sh pairs the senior with BASE_MODEL as the frozen junior. Override JUNIOR only
# to evaluate a pairing the senior was not trained against; the two models must share a
# tokenizer and vocabulary, and eval/handoff.py checks that before it starts.
# export JUNIOR=$BASE_MODEL

# Optional shared HuggingFace cache. Unset means ~/.cache/huggingface and a
# first-run download of BASE_MODEL.
# export HF_HOME=/shared/hf-hub

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
# This file locates the repo from its own path so the defaults below hold no
# matter which directory sourced it.
_tandem_repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

# Training writes $CKPT_ROOT/<experiment>/, with HF weights under its hf/
# subdirectory. Point this at a filesystem with room: the actor checkpoints are
# pruned to MAX_CKPT_KEEP but the HF copies are kept for every save, about 8 GB
# each for a 4B model.
export CKPT_ROOT=${CKPT_ROOT:-$_tandem_repo/checkpoints}

# Holds deepscaler/train.parquet (built by data/build_deepscaler.py) and the
# shipped eval/ parquets.
export DATA_ROOT=${DATA_ROOT:-$_tandem_repo/data}

unset _tandem_repo

# Caches default under $HOME. On a shared node with a small home quota, redirect
# them to scratch instead:
# export XDG_CACHE_HOME=/scratch/$USER/.cache/xdg
# export VLLM_CACHE_ROOT=/scratch/$USER/.cache/vllm
# export TRITON_CACHE_DIR=/scratch/$USER/.cache/triton
# export CUDA_CACHE_PATH=/scratch/$USER/.cache/nv
# export WANDB_DIR=/scratch/$USER/wandb

# ---------------------------------------------------------------------------
# Weights & Biases
# ---------------------------------------------------------------------------
# All four launchers log to this project; they set trainer.experiment_name per
# arm, so one project holds the whole comparison.
export PROJECT_NAME=${PROJECT_NAME:-tandem-rlvr}

# Optional file holding WANDB_API_KEY=... and anything else wandb needs.
# WANDB_SECRETS=$HOME/.config/wandb_secrets.env
if [ -n "${WANDB_SECRETS:-}" ] && [ -f "$WANDB_SECRETS" ]; then
    set -a
    # shellcheck disable=SC1090
    source "$WANDB_SECRETS"
    set +a
fi

# Without a key the run still trains and still logs, to ./wandb; `wandb sync`
# uploads it afterwards. Set WANDB_MODE=disabled to turn logging off entirely.
if [ -n "${WANDB_API_KEY:-}" ]; then
    export WANDB_MODE=${WANDB_MODE:-online}
else
    export WANDB_MODE=${WANDB_MODE:-offline}
fi
